<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0A0E14" />
        </shape>
    </item>
    <!-- Gradient overlay -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#2000D4FF"
                android:centerColor="#1000D4FF"
                android:endColor="#0000D4FF"
                android:angle="45" />
        </shape>
    </item>
    <!-- Center orb glow -->
    <item
        android:gravity="center"
        android:width="80dp"
        android:height="80dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="40dp"
                android:startColor="#4000D4FF"
                android:endColor="#0000D4FF" />
        </shape>
    </item>
</layer-list>
